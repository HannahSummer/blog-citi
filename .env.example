# Site (Vite). Endereço da API, sem /api no fim.
# Local com docker compose: http://localhost:3000. Em produção, o endereço da API no Coolify.
VITE_API_URL=http://localhost:3000

# Radar semanal (npm run radar:semanal). Só no seu .env local e no GitHub Secrets; nunca com VITE_.
# ANTHROPIC_API_KEY=
# API_URL=http://localhost:3000
# RADAR_TOKEN=
