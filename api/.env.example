# API do Blog CITi. Copie para api/.env (local) ou cadastre no Coolify (produção).
# Nunca commite o .env com valores reais.

# Postgres. No docker-compose local já vem preenchido; no Coolify, use a "Postgres URL (internal)".
DATABASE_URL=postgresql://citi:citi@localhost:5433/blog_citi

# Assina o login das editoras. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Token que o radar semanal (GitHub Actions) usa para enviar sugestões. Gere do mesmo jeito.
RADAR_TOKEN=

# Endereço(s) do site que podem chamar a API, separados por vírgula.
SITE_URL=http://localhost:5173

# Documentação interativa em /api/docs. Deixe false em produção (ou true só para testar).
SWAGGER_HABILITADO=false

PORT=3000

# Publicação de artigos pelo painel (/blog/admin/artigos). Opcional: sem estas três, o painel avisa que falta configurar.
# GITHUB_TOKEN: token "fine-grained" do GitHub, só para este repositório, com permissão Contents: Read and write.
# GITHUB_BRANCH: a branch que o Coolify publica (hoje deploy-coolify; depois do merge, main).
GITHUB_TOKEN=
GITHUB_REPO=HannahSummer/blog-citi
GITHUB_BRANCH=main
