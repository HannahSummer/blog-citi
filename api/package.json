{
  "name": "blog-citi-api",
  "private": true,
  "version": "1.0.0",
  "description": "API do Blog CITi: diagnóstico, newsletter e curadoria de notícias (NestJS + Postgres).",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/api/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "db:migrar": "prisma migrate deploy",
    "db:nova-migracao": "prisma migrate dev --create-only",
    "editora": "node dist/api/src/cli/editora.js",
    "postinstall": "prisma generate",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
